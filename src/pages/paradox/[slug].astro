---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import DepthRail from '../../components/DepthRail.astro';
import ParadoxCard from '../../components/ParadoxCard.astro';
import Citation from '../../components/Citation.astro';
import Interactive from '../../components/Interactive.astro';
import Figure from '../../components/Figure.astro';

import { publicCatalog } from '../../lib/catalog.js';
import { LAYERS, DEPTHS } from '../../lib/sections.js';
import { relatedParadoxes, byRenown } from '../../lib/graph.js';
import { figureFor, slugsWithFigure } from '../../lib/figures.js';
import { toPlainText } from '../../lib/markdown.js';
import { url, SITE } from '../../lib/site.js';

export async function getStaticPaths() {
  const catalog = publicCatalog();
  return catalog.paradoxes.map((paradox) => ({
    params: { slug: paradox.slug },
    props: { paradox },
  }));
}

const { paradox } = Astro.props;
const catalog = publicCatalog();
const tx = catalog.taxonomy;

const nature = tx.get('natures', paradox.nature);
const status = tx.get('statuses', paradox.status);
const difficulty = tx.get('difficulties', paradox.difficulty);
const era = tx.get('eras', paradox.era);
const primaryDomain = tx.get('domains', paradox.domains[0]);

// Only render layers this entry actually has, in canonical order.
const layers = LAYERS.filter((l) => (paradox.sections[l.id] ?? '').trim());
// Each depth's anchor points to the FIRST actual layer in that depth so the
// rail links never hit a missing element (e.g. only "History" exists under the
// "Explore" depth but not the "Explore" layer itself).
const activeDepths = DEPTHS.filter(
  (d) => d.id === 'research' || layers.some((l) => l.depth === d.id)
).map((d) => {
  if (d.id === 'research') return { ...d, anchor: 'research' };
  const firstLayer = layers.find((l) => l.depth === d.id);
  return { ...d, anchor: firstLayer?.id ?? d.id };
});

const people = paradox.people.map((id) => catalog.personById.get(id)).filter(Boolean);

// Group relationships by kind so the page reads as a set of statements.
const relGroups = new Map();
for (const rel of paradox.allRelationships ?? []) {
  const target = catalog.bySlug.get(rel.to);
  if (!target) continue;
  if (!relGroups.has(rel.kind)) relGroups.set(rel.kind, []);
  relGroups.get(rel.kind).push({ ...rel, target });
}
const orderedRelGroups = tx.relationshipKinds
  .filter((k) => relGroups.has(k.id))
  .map((k) => ({ kind: k, items: relGroups.get(k.id) }));

// References grouped by role, in taxonomy order.
const refs = paradox.references
  .map((r) => ({ ...r, source: catalog.sourceById.get(r.source) }))
  .filter((r) => r.source);
const refGroups = tx.sourceTypes
  .map((type) => ({
    type,
    items: refs.filter((r) => (r.role ?? r.source.type) === type.id),
  }))
  .filter((g) => g.items.length > 0);

const related = relatedParadoxes(catalog, paradox, 6);
const description = paradox.summary;

// Entries built on the same structure. This is the most useful "next" link on
// the page: not "also about physics", but "this is the same trouble again".
const figure = figureFor(paradox.slug);
const sameShape = figure
  ? slugsWithFigure(figure.id)
      .filter((s) => s !== paradox.slug)
      .map((s) => catalog.bySlug.get(s))
      .filter(Boolean)
      .sort(byRenown)
      .slice(0, 5)
  : [];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: paradox.title,
  alternativeHeadline: paradox.alternateNames,
  description,
  about: paradox.domains.map((d) => tx.label('domains', d)),
  keywords: [...paradox.concepts, ...paradox.alternateNames].join(', '),
  datePublished: paradox.publishing.created,
  dateModified: paradox.publishing.updated,
  url: new URL(url.paradox(paradox.slug), Astro.site ?? 'https://localhost').href,
  isPartOf: { '@type': 'WebSite', name: SITE.name },
  citation: refs.map((r) => ({
    '@type': 'CreativeWork',
    name: r.source.title,
    author: r.source.authors.join(', ') || undefined,
    datePublished: r.source.year ? String(r.source.year) : undefined,
  })),
};
---

<Base title={paradox.title} description={description} type="article" jsonLd={jsonLd}>
  {/* Reading progress bar — fills as the user scrolls through the article */}
  <div class="px__progress" id="px-progress" aria-hidden="true"></div>

  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span aria-hidden="true">/</span>
    <a href={url.browse()}>Browse</a>
    {primaryDomain && (
      <>
        <span aria-hidden="true">/</span>
        <a href={url.domain(primaryDomain.id)}>{primaryDomain.label}</a>
      </>
    )}
  </nav>

  <article class="px" id="px-article">
    <header class="px__header">
      <p class="px__kicker">
        <a class="tag tag--dot" style={`--dot:${primaryDomain?.color}`} href={url.domain(paradox.domains[0])}>
          {primaryDomain?.label}
        </a>
        <a class="tag" href={url.nature(paradox.nature)}>{nature?.label}</a>
        <a class="tag" href={url.status(paradox.status)}>{status?.label}</a>
        {paradox.renown === 'landmark' && <span class="tag tag--warm">★ Famous</span>}
      </p>

      <h1>{paradox.title}</h1>

      {paradox.alternateNames.length > 0 && (
        <p class="px__alt">Also known as {paradox.alternateNames.join(', ')}</p>
      )}

      {paradox.hook
        ? <p class="px__hook">{paradox.hook}</p>
        : <p class="px__summary lede">{paradox.summary}</p>}

      <dl class="px__facts">
        <div>
          <dt>When</dt>
          <dd><a href={url.era(paradox.era)}>{paradox.date}</a></dd>
        </div>
        <div>
          <dt>Difficulty</dt>
          <dd><a href={url.difficulty(paradox.difficulty)}>{difficulty?.label}</a></dd>
        </div>
        <div>
          <dt>Reading time</dt>
          <dd>{paradox.readingMinutes} min</dd>
        </div>
        {people.length > 0 && (
          <div>
            <dt>People</dt>
            <dd class="px__facts-people">{people.map((p, i) => (
              <>{i > 0 && <span class="px__facts-sep">,</span>}<a href={url.person(p.id)}>{p.name}</a></>
            ))}</dd>
          </div>
        )}
      </dl>

      {nature && (
        <p class="px__nature-note">
          <b>{nature.label}.</b> {nature.explanation}
        </p>
      )}
    </header>

    <div class="px__layout">
      <aside class="px__rail">
        <div class="px__rail-inner">
          <DepthRail depths={activeDepths} />
        </div>
      </aside>

      <div class="px__body prose">
        {layers.map((layer) => (
          <>
            <Section layer={layer} markdown={paradox.sections[layer.id]} open={layer.openByDefault} />
            {layer.id === 'understand' && paradox.interactive && (
              <Interactive id={paradox.interactive} />
            )}
            {/* The diagram lands once the explanation is read, not before it —
                it consolidates the shape rather than previewing the answer. */}
            {layer.id === 'understand' && figure && (
              <section class="layer" id="shape">
                <h2 class="layer__heading">The shape of it</h2>
                <Figure slug={paradox.slug} variant="page" />
                {sameShape.length > 0 && (
                  <div class="shape__also">
                    <p class="shape__lead">Same shape, different costume:</p>
                    <ul class="tags">
                      {sameShape.map((p) => (
                        <li><a class="tag" href={url.paradox(p.slug)}>{p.title}</a></li>
                      ))}
                    </ul>
                  </div>
                )}
              </section>
            )}
          </>
        ))}

        <section class="layer" id="research">
          <h2 class="layer__heading">Sources &amp; further reading</h2>

          {refGroups.length === 0 && paradox.furtherReading.length === 0 && (
            <p class="px__norefs">No references recorded yet.</p>
          )}

          {refGroups.map((group) => (
            <div class="px__refgroup">
              <h3>{group.type.label}</h3>
              <ul class="px__refs">
                {group.items.map((r) => (
                  <Citation source={r.source} locator={r.locator} note={r.note} />
                ))}
              </ul>
            </div>
          ))}

          {paradox.furtherReading.length > 0 && (
            <div class="px__refgroup">
              <h3>Elsewhere on the web</h3>
              <ul class="px__links">
                {paradox.furtherReading.map((link) => (
                  <li>
                    <a href={link.url} target="_blank" rel="noopener noreferrer">{link.title}</a>
                    {link.note && <span> — {link.note}</span>}
                  </li>
                ))}
              </ul>
            </div>
          )}
        </section>

        {orderedRelGroups.length > 0 && (
          <section class="layer" id="connections">
            <h2 class="layer__heading">How this connects</h2>
            <dl class="px__rels">
              {orderedRelGroups.map((group) => (
                <div>
                  <dt>{group.kind.label}</dt>
                  <dd>
                    <ul>
                      {group.items.map((item) => (
                        <li>
                          <a href={url.paradox(item.target.slug)}>{item.target.title}</a>
                          {item.note && <span class="px__relnote">{item.note}</span>}
                        </li>
                      ))}
                    </ul>
                  </dd>
                </div>
              ))}
            </dl>
          </section>
        )}

        {paradox.concepts.length > 0 && (
          <section class="layer">
            <h2 class="layer__heading">Ideas involved</h2>
            <ul class="tags">
              {paradox.concepts.map((c) => <li><span class="tag">{c}</span></li>)}
              {paradox.types.map((t) => (
                <li><a class="tag tag--accent" href={url.type(t)}>{tx.label('types', t)}</a></li>
              ))}
            </ul>
          </section>
        )}

        {paradox.paths.length > 0 && (
          <section class="layer">
            <h2 class="layer__heading">Part of a learning path</h2>
            <ul class="px__paths">
              {paradox.paths.map(({ path, index }) => (
                <li>
                  <a href={url.path(path.id)}>{path.title}</a>
                  <span> — step {index + 1} of {path.steps.length}</span>
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>
    </div>
  </article>

  {related.length > 0 && (
    <section class="section">
      <div class="section__head">
        <div>
          <h2>Where to go next</h2>
          <p>Each one says why it follows from what you just read.</p>
        </div>
        <a class="section__more" href="/random/">Or surprise me →</a>
      </div>
      <div class="grid grid--3">
        {related.map((r) => <ParadoxCard paradox={r.paradox} reason={r.reason} compact />)}
      </div>
    </section>
  )}

  {/* Scroll-to-top button — appears after scrolling down 400 px */}
  <button class="px__top" id="px-top" aria-label="Back to top" title="Back to top">↑</button>
</Base>

<style>
  /* ── Progress bar ── */
  .px__progress {
    position: fixed;
    top: 3.75rem; /* sits flush under the sticky nav */
    left: 0;
    width: 0%;
    height: 3px;
    background: var(--accent);
    z-index: 30;
    transition: width 0.1s linear;
    transform-origin: left;
    pointer-events: none;
  }

  /* ── Article ── */
  .px { margin-bottom: 3rem; }

  /* ── Header ── */
  .px__header {
    padding-block: 1.5rem 2.5rem;
    border-bottom: 1px solid var(--line);
    margin-bottom: 2rem;
  }

  .px__kicker {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-bottom: 1.1rem;
  }

  .px__header h1 {
    margin-bottom: 0.3rem;
    letter-spacing: -0.025em;
  }

  .px__alt {
    font-family: var(--font-ui);
    font-size: 0.86rem;
    color: var(--ink-faint);
    margin: 0 0 1.1rem;
    font-style: italic;
  }

  .px__summary { max-width: 44rem; margin-bottom: 1.75rem; }

  /* The hook — shown when the author provided it; larger than body text so a
     reader arriving from search meets the puzzle before anything else. */
  .px__hook {
    max-width: 42rem;
    margin: 0 0 1.75rem;
    font-size: clamp(1.18rem, 2.2vw, 1.48rem);
    line-height: 1.48;
    color: var(--ink);
    text-wrap: pretty;
    font-style: italic;
  }

  /* ── Facts strip ── */
  .px__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0;
    margin: 0 0 1.75rem;
    padding: 0.9rem 0;
    border-block: 1px solid var(--line-soft);
    font-family: var(--font-ui);
  }
  .px__facts > div {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding-block: 0.3rem;
    padding-right: 2rem;
    border-right: 1px solid var(--line-soft);
    margin-right: 2rem;
  }
  .px__facts > div:last-child { border-right: 0; margin-right: 0; padding-right: 0; }
  .px__facts dt {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--ink-faint);
    font-weight: 650;
  }
  .px__facts dd { margin: 0; font-size: 0.93rem; font-weight: 500; }
  .px__facts-people { display: flex; flex-wrap: wrap; gap: 0 0.25rem; }
  .px__facts-sep { color: var(--ink-faint); }

  /* ── Nature callout ── */
  .px__nature-note {
    font-family: var(--font-ui);
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--ink-soft);
    background: var(--surface-alt);
    border-left: 3px solid var(--accent);
    padding: 0.85rem 1.1rem;
    border-radius: 0 var(--radius) var(--radius) 0;
    margin: 0;
    max-width: 44rem;
  }
  .px__nature-note b { color: var(--ink); }

  /* ── Two-column layout ── */
  .px__layout {
    display: grid;
    grid-template-columns: 15rem minmax(0, 1fr);
    gap: 3rem;
    align-items: start;
  }
  .px__rail-inner {
    position: sticky;
    top: 5.5rem;
    /* Ensure the rail never taller than the viewport so it can scroll if needed */
    max-height: calc(100vh - 7rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--line) transparent;
  }
  .px__rail-inner::-webkit-scrollbar { width: 4px; }
  .px__rail-inner::-webkit-scrollbar-thumb { background: var(--line); border-radius: 2px; }
  .px__body { width: min(100%, 40rem); }

  @media (max-width: 62rem) {
    .px__header { padding-block: 1rem 1.75rem; margin-bottom: 1.25rem; }
    .px__layout { grid-template-columns: 1fr; gap: 1rem; }
    .px__rail-inner {
      position: static;
      max-height: none;
      overflow: visible;
    }
    .px__body { width: 100%; }
  }

  /* ── Shape section ── */
  .shape__also { margin-top: 1.25rem; }
  .shape__lead {
    font-family: var(--font-ui);
    font-size: 0.78rem;
    font-weight: 620;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--ink-faint);
    margin: 0 0 0.55rem;
  }

  /* ── References ── */
  .px__refgroup { margin-bottom: 1.75rem; }
  .px__refgroup h3 {
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
    margin-bottom: 0.5rem;
  }
  .px__refs { list-style: none; padding: 0; margin: 0; }
  .px__links { padding-left: 1.1rem; font-family: var(--font-ui); font-size: 0.92rem; }
  .px__links span { color: var(--ink-faint); }
  .px__norefs { color: var(--ink-faint); font-style: italic; }

  /* ── Relationships ── */
  .px__rels { margin: 0; }
  .px__rels > div { margin-bottom: 1.25rem; }
  .px__rels dt {
    font-family: var(--font-ui);
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
    font-weight: 620;
    margin-bottom: 0.3rem;
  }
  .px__rels dd { margin: 0; }
  .px__rels ul { list-style: none; padding: 0; margin: 0; }
  .px__rels li { margin-bottom: 0.5rem; }
  .px__rels a { font-family: var(--font-ui); font-weight: 550; font-size: 0.95rem; }
  .px__relnote {
    display: block;
    font-size: 0.85rem;
    color: var(--ink-soft);
    line-height: 1.45;
  }

  /* ── Paths ── */
  .px__paths { list-style: none; padding: 0; font-family: var(--font-ui); font-size: 0.93rem; }
  .px__paths li { padding: 0.5rem 0; border-bottom: 1px solid var(--line-soft); }
  .px__paths li:last-child { border-bottom: 0; }
  .px__paths span { color: var(--ink-faint); }

  /* ── Scroll-to-top button ── */
  .px__top {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    width: 2.8rem;
    height: 2.8rem;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink-soft);
    font-size: 1.1rem;
    cursor: pointer;
    box-shadow: var(--shadow);
    display: grid;
    place-items: center;
    opacity: 0;
    translate: 0 0.5rem;
    transition: opacity 0.2s, translate 0.2s, background 0.15s, color 0.15s;
    pointer-events: none;
    z-index: 20;
  }
  .px__top:hover { background: var(--accent-wash); color: var(--accent-ink); border-color: var(--accent); }
  .px__top.is-visible { opacity: 1; translate: 0 0; pointer-events: auto; }

  @media (max-width: 40rem) {
    .px__top { bottom: 1rem; right: 1rem; width: 2.5rem; height: 2.5rem; font-size: 1rem; }
  }
</style>

<script>
  // ── Reading progress bar ──────────────────────────────────────────
  const bar = document.getElementById('px-progress');
  const article = document.getElementById('px-article');

  if (bar && article) {
    const update = () => {
      const rect = article.getBoundingClientRect();
      const total = rect.height - window.innerHeight;
      const scrolled = Math.max(0, -rect.top);
      const pct = total > 0 ? Math.min(100, (scrolled / total) * 100) : 0;
      bar.style.width = pct + '%';
    };
    window.addEventListener('scroll', update, { passive: true });
    update();
  }

  // ── Scroll-to-top button ──────────────────────────────────────────
  const topBtn = document.getElementById('px-top');
  if (topBtn) {
    const onScroll = () => {
      topBtn.classList.toggle('is-visible', window.scrollY > 400);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    topBtn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
    onScroll();
  }
</script>
