---
import Base from '../layouts/Base.astro';
import ParadoxCard from '../components/ParadoxCard.astro';
import { publicCatalog } from '../lib/catalog.js';
import { headline, byRenown, shuffleStable } from '../lib/graph.js';
import { url, SITE } from '../lib/site.js';

const catalog = publicCatalog();
const tx = catalog.taxonomy;

// Curiosity-first entry points. These are questions, not taxonomy.
const MOODS = [
  { label: 'Make me think', href: url.difficulty('beginner'), hint: 'Start somewhere gentle' },
  { label: 'Question reality', href: url.type('identity'), hint: 'Identity, time and change' },
  { label: 'Break my intuition', href: url.nature('counterintuitive-result'), hint: 'True, provable, and wrong-feeling' },
  { label: 'Play a probability puzzle', href: url.domain('probability'), hint: 'Chance behaves oddly' },
  { label: 'Show me a limit', href: url.nature('impossibility-result'), hint: 'Things provably impossible' },
  { label: 'Something unresolved', href: url.nature('open-problem'), hint: 'Experts still disagree' },
];

// The opening row is the entries a first-time visitor is most likely to have
// heard of, spread across fields so the collection does not look like one
// subject. Recognition is what earns the second click.
const famous = headline(catalog.paradoxes, 6, 2);

// One question, posed in full, above the fold. Rotates so a returning reader
// meets a different one.
const rotation = catalog.paradoxes.length + new Date().getUTCDate();
const landmarks = catalog.paradoxes.filter((p) => p.renown === 'landmark' && p.hook);
const teaser = shuffleStable(landmarks, rotation)[0];

// The reward for going deeper: things almost nobody has heard of.
const obscure = shuffleStable(
  catalog.paradoxes.filter((p) => p.renown === 'specialist'),
  rotation
).slice(0, 3);

// The lead row is already weighted towards beginner entries, so this section
// has to skip whatever is directly above it or the page repeats itself.
const shown = new Set(famous.map((p) => p.slug));
const beginner = catalog.paradoxes
  .filter((p) => p.difficulty === 'beginner' && !shown.has(p.slug))
  .sort(byRenown)
  .slice(0, 3);

const domains = tx.domains
  .map((d) => ({ ...d, count: catalog.paradoxes.filter((p) => p.domains.includes(d.id)).length }))
  .filter((d) => d.count > 0);

const paths = catalog.paths.slice(0, 4);

const eras = tx.eras
  .map((e) => ({ ...e, count: catalog.paradoxes.filter((p) => p.era === e.id).length }))
  .filter((e) => e.count > 0);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  description: SITE.description,
  url: SITE.url,
};
---

<Base jsonLd={jsonLd}>
  <section class="hero">
    <h1 class="hero__title">
      Some ideas <em>argue</em> with your intuition.
    </h1>
    <p class="hero__lede">
      {catalog.paradoxes.length} of them — from a puzzle told 2,500 years ago to
      results proved last decade. Each one starts as a story anyone can follow
      and goes as deep as you care to take it.
    </p>

    <div class="hero__actions">
      <a class="btn btn--primary" href="#famous">Start with a famous one</a>
      <a class="btn" href="/random/">Surprise me</a>
      <a class="btn" href={url.browse()}>Browse everything</a>
    </div>
  </section>

  {teaser && (
    <a class="teaser" href={url.paradox(teaser.slug)}>
      <span class="teaser__label">For instance</span>
      <p class="teaser__hook">{teaser.hook}</p>
      <span class="teaser__cta">{teaser.title}</span>
    </a>
  )}

  <section class="section" id="famous">
    <div class="section__head">
      <div>
        <h2>The ones you have probably heard of</h2>
        <p>Famous for a reason. Any of these is a good first door.</p>
      </div>
      <a class="section__more" href={url.browse()}>See all {catalog.paradoxes.length} →</a>
    </div>
    <div class="grid grid--3">
      {famous.map((p) => <ParadoxCard paradox={p} compact figure />)}
    </div>
  </section>

  <section class="section" aria-labelledby="moods">
    <div class="section__head">
      <div>
        <h2 id="moods">Or go by what you are in the mood for</h2>
        <p>You do not need to know the classification to start exploring.</p>
      </div>
    </div>
    <ul class="moods">
      {
        MOODS.map((m) => (
          <li>
            <a href={m.href}>
              <b>{m.label}</b>
              <span>{m.hint}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {beginner.length > 0 && (
    <section class="section">
      <div class="section__head">
        <div>
          <h2>Good places to start</h2>
          <p>No background needed at any point. Suitable for younger readers.</p>
        </div>
        <a class="section__more" href={url.difficulty('beginner')}>All beginner entries →</a>
      </div>
      <div class="grid grid--3">
        {beginner.map((p) => <ParadoxCard paradox={p} compact />)}
      </div>
    </section>
  )}

  {paths.length > 0 && (
    <section class="section">
      <div class="section__head">
        <div>
          <h2>Follow a thread</h2>
          <p>Ordered sequences where each idea sets up the next.</p>
        </div>
        <a class="section__more" href="/paths/">All learning paths →</a>
      </div>
      <div class="grid grid--2">
        {
          paths.map((path) => (
            <a class="pathcard" href={url.path(path.id)}>
              <b>{path.title}</b>
              <span>{path.summary}</span>
              <ol>
                {path.steps.slice(0, 5).map((s) => (
                  <li>{catalog.bySlug.get(s.paradox)?.title ?? s.paradox}</li>
                ))}
                {path.steps.length > 5 && <li class="pathcard__more">+{path.steps.length - 5} more</li>}
              </ol>
            </a>
          ))
        }
      </div>
    </section>
  )}

  {obscure.length > 0 && (
    <section class="section">
      <div class="section__head">
        <div>
          <h2>Less famous, no less strange</h2>
          <p>Well known inside one field and almost nowhere else.</p>
        </div>
        <a class="section__more" href="/random/">Give me another →</a>
      </div>
      <div class="grid grid--3">
        {obscure.map((p) => <ParadoxCard paradox={p} compact figure />)}
      </div>
    </section>
  )}

  <section class="section">
    <div class="section__head">
      <div>
        <h2>Pick a field</h2>
        <p>The same handful of problems keeps turning up in all of them.</p>
      </div>
      <a class="section__more" href="/map/">See how they connect →</a>
    </div>
    <ul class="domains">
      {
        domains.map((d) => (
          <li>
            <a href={url.domain(d.id)} style={`--dot:${d.color}`}>
              <b>{d.label}</b>
              <span>{d.short}</span>
              <em>{d.count}</em>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {eras.length > 0 && (
    <section class="section">
      <div class="section__head">
        <div>
          <h2>Or start from a century</h2>
          <p>The same questions keep resurfacing in new clothes.</p>
        </div>
        <a class="section__more" href="/timeline/">Full timeline →</a>
      </div>
      <ul class="eras">
        {
          eras.map((e) => (
            <li>
              <a href={url.era(e.id)}>
                <b>{e.label}</b>
                <span>{e.short}</span>
                <em>{e.count}</em>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  )}
</Base>

<style>
  .hero {
    padding-block: clamp(2.5rem, 8vw, 4.5rem) clamp(1.25rem, 3vw, 2rem);
    max-width: 46rem;
  }
  .hero__title {
    font-size: clamp(2.1rem, 6vw, 3.9rem);
    letter-spacing: -0.035em;
    line-height: 1.05;
    margin-bottom: 1.1rem;
  }
  .hero__title em {
    font-style: italic;
    color: var(--accent);
  }
  .hero__lede {
    font-size: clamp(1.05rem, 1.6vw, 1.22rem);
    color: var(--ink-soft);
    line-height: 1.6;
    margin-bottom: 1.8rem;
    max-width: 40rem;
  }
  .hero__actions { display: flex; gap: 0.6rem; flex-wrap: wrap; }

  /* One real question, above the fold. The gap it opens is the whole pitch —
     everything else on this page is navigation. */
  .teaser {
    display: block;
    max-width: 46rem;
    padding: 1.35rem 1.6rem 1.2rem;
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent);
    border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
    background: var(--surface);
    box-shadow: var(--shadow);
    text-decoration: none;
    transition: box-shadow 0.18s, transform 0.18s;
  }
  .teaser:hover { box-shadow: var(--shadow-lift); transform: translateY(-2px); }
  .teaser__label {
    display: block;
    font-family: var(--font-ui);
    font-size: 0.72rem;
    font-weight: 640;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--ink-faint);
    margin-bottom: 0.5rem;
  }
  .teaser__hook {
    margin: 0 0 0.7rem;
    font-size: clamp(1.08rem, 1.9vw, 1.32rem);
    line-height: 1.45;
    color: var(--ink);
    text-wrap: pretty;
  }
  .teaser__cta {
    font-family: var(--font-ui);
    font-size: 0.88rem;
    font-weight: 580;
    color: var(--accent-ink);
  }
  .teaser__cta::after { content: ' →'; }

  .moods {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.6rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
  }
  .moods a {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.85rem 1rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    background: var(--surface);
    text-decoration: none;
    font-family: var(--font-ui);
    height: 100%;
    transition: border-color 0.15s, background 0.15s, transform 0.15s;
  }
  .moods a:hover {
    border-color: var(--accent);
    background: var(--accent-wash);
    transform: translateY(-2px);
  }
  .moods b { font-size: 0.98rem; font-weight: 620; color: var(--ink); }
  .moods span { font-size: 0.8rem; color: var(--ink-faint); }

  .domains, .eras {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.55rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
  }
  .domains a, .eras a {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 0.2rem 0.6rem;
    padding: 0.8rem 1rem;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--surface);
    text-decoration: none;
    font-family: var(--font-ui);
    height: 100%;
    border-left: 3px solid var(--dot, var(--line));
    transition: background 0.15s, transform 0.15s;
  }
  .domains a:hover, .eras a:hover { background: var(--surface-alt); transform: translateX(2px); }
  .domains b, .eras b { font-size: 0.95rem; font-weight: 620; color: var(--ink); }
  .domains span, .eras span {
    grid-column: 1;
    font-size: 0.79rem;
    color: var(--ink-faint);
    line-height: 1.4;
  }
  .domains em, .eras em {
    grid-row: 1;
    grid-column: 2;
    font-style: normal;
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
    color: var(--ink-faint);
    background: var(--surface-alt);
    border-radius: 999px;
    padding: 0.1rem 0.45rem;
  }

  .pathcard {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.15rem 1.3rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    text-decoration: none;
    font-family: var(--font-ui);
    box-shadow: var(--shadow);
    transition: box-shadow 0.18s, transform 0.18s;
  }
  .pathcard:hover { box-shadow: var(--shadow-lift); transform: translateY(-2px); }
  .pathcard b { font-size: 1.05rem; color: var(--ink); font-weight: 640; }
  .pathcard > span { font-size: 0.87rem; color: var(--ink-soft); line-height: 1.5; }
  .pathcard ol {
    margin: 0.6rem 0 0;
    padding-left: 1.1rem;
    font-size: 0.83rem;
    color: var(--ink-faint);
  }
  .pathcard li { margin-bottom: 0.15rem; }
  .pathcard__more { list-style: none; margin-left: -1.1rem; font-style: italic; }
</style>
