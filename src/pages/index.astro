---
import Base from '../layouts/Base.astro';
import ParadoxCard from '../components/ParadoxCard.astro';
import { publicCatalog } from '../lib/catalog.js';
import { shuffleStable } from '../lib/graph.js';
import { url, SITE } from '../lib/site.js';

const catalog = publicCatalog();
const tx = catalog.taxonomy;

// Curiosity-first entry points. These are questions, not taxonomy.
const MOODS = [
  { label: 'Make me think', href: url.difficulty('beginner'), hint: 'Start somewhere gentle' },
  { label: 'Question reality', href: url.type('identity'), hint: 'Identity, time and change' },
  { label: 'Break my intuition', href: url.nature('counterintuitive-result'), hint: 'True, provable, and wrong-feeling' },
  { label: 'Play a probability puzzle', href: url.domain('probability'), hint: 'Chance behaves oddly' },
  { label: 'Show me a limit', href: url.nature('impossibility-result'), hint: 'Things provably impossible' },
  { label: 'Something unresolved', href: url.nature('open-problem'), hint: 'Experts still disagree' },
];

const domains = tx.domains
  .map((d) => ({ ...d, count: catalog.paradoxes.filter((p) => p.domains.includes(d.id)).length }))
  .filter((d) => d.count > 0);

// A stable pick that rotates each build — keeps the page static and cacheable.
const seed = catalog.paradoxes.length + new Date().getUTCDate();
const featured = shuffleStable(catalog.paradoxes, seed).slice(0, 6);

const beginner = catalog.paradoxes.filter((p) => p.difficulty === 'beginner').slice(0, 3);
const paths = catalog.paths.slice(0, 4);

const eras = tx.eras
  .map((e) => ({ ...e, count: catalog.paradoxes.filter((p) => p.era === e.id).length }))
  .filter((e) => e.count > 0);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  description: SITE.description,
  url: SITE.url,
};
---

<Base jsonLd={jsonLd}>
  <section class="hero">
    <h1 class="hero__title">
      Some ideas <em>argue</em> with your intuition.
    </h1>
    <p class="hero__lede">
      A curated collection of {catalog.paradoxes.length} paradoxes — from a puzzle
      told 2,500 years ago to results proved last decade. Every one is explained
      first as a story anyone can follow, then as deeply as you care to go.
    </p>

    <div class="hero__actions">
      <a class="btn btn--primary" href="/random/">Surprise me</a>
      <a class="btn" href={url.browse()}>Browse everything</a>
      <a class="btn" href="/timeline/">Walk through time</a>
    </div>
  </section>

  <section class="section" aria-labelledby="moods">
    <h2 class="visually-hidden" id="moods">Start with a mood</h2>
    <ul class="moods">
      {
        MOODS.map((m) => (
          <li>
            <a href={m.href}>
              <b>{m.label}</b>
              <span>{m.hint}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section">
    <div class="section__head">
      <div>
        <h2>Pick a field</h2>
        <p>You do not need to know the classification to start exploring.</p>
      </div>
      <a class="section__more" href="/taxonomy/">How this is organised →</a>
    </div>
    <ul class="domains">
      {
        domains.map((d) => (
          <li>
            <a href={url.domain(d.id)} style={`--dot:${d.color}`}>
              <b>{d.label}</b>
              <span>{d.short}</span>
              <em>{d.count}</em>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {beginner.length > 0 && (
    <section class="section">
      <div class="section__head">
        <div>
          <h2>Good places to start</h2>
          <p>No background needed. Suitable for younger readers.</p>
        </div>
        <a class="section__more" href={url.difficulty('beginner')}>All beginner entries →</a>
      </div>
      <div class="grid grid--3">
        {beginner.map((p) => <ParadoxCard paradox={p} compact />)}
      </div>
    </section>
  )}

  {paths.length > 0 && (
    <section class="section">
      <div class="section__head">
        <div>
          <h2>Follow a thread</h2>
          <p>Curated sequences where each idea sets up the next.</p>
        </div>
        <a class="section__more" href="/paths/">All learning paths →</a>
      </div>
      <div class="grid grid--2">
        {
          paths.map((path) => (
            <a class="pathcard" href={url.path(path.id)}>
              <b>{path.title}</b>
              <span>{path.summary}</span>
              <ol>
                {path.steps.slice(0, 5).map((s) => (
                  <li>{catalog.bySlug.get(s.paradox)?.title ?? s.paradox}</li>
                ))}
                {path.steps.length > 5 && <li class="pathcard__more">+{path.steps.length - 5} more</li>}
              </ol>
            </a>
          ))
        }
      </div>
    </section>
  )}

  <section class="section">
    <div class="section__head">
      <div>
        <h2>A different six every build</h2>
        <p>Because the best way to find something is to not be looking for it.</p>
      </div>
      <a class="section__more" href="/random/">Give me another →</a>
    </div>
    <div class="grid grid--3">
      {featured.map((p) => <ParadoxCard paradox={p} compact />)}
    </div>
  </section>

  {eras.length > 0 && (
    <section class="section">
      <div class="section__head">
        <div>
          <h2>Or start from a century</h2>
          <p>The same questions keep resurfacing in new clothes.</p>
        </div>
        <a class="section__more" href="/timeline/">Full timeline →</a>
      </div>
      <ul class="eras">
        {
          eras.map((e) => (
            <li>
              <a href={url.era(e.id)}>
                <b>{e.label}</b>
                <span>{e.short}</span>
                <em>{e.count}</em>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  )}
</Base>

<style>
  .hero {
    padding-block: clamp(2.5rem, 8vw, 5rem) clamp(1.5rem, 4vw, 2.5rem);
    max-width: 46rem;
  }
  .hero__title {
    font-size: clamp(2.1rem, 6vw, 3.9rem);
    letter-spacing: -0.035em;
    line-height: 1.05;
    margin-bottom: 1.1rem;
  }
  .hero__title em {
    font-style: italic;
    color: var(--accent);
  }
  .hero__lede {
    font-size: clamp(1.05rem, 1.6vw, 1.22rem);
    color: var(--ink-soft);
    line-height: 1.6;
    margin-bottom: 1.8rem;
    max-width: 40rem;
  }
  .hero__actions { display: flex; gap: 0.6rem; flex-wrap: wrap; }

  .moods {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.6rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
  }
  .moods a {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.85rem 1rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    background: var(--surface);
    text-decoration: none;
    font-family: var(--font-ui);
    height: 100%;
    transition: border-color 0.15s, background 0.15s, transform 0.15s;
  }
  .moods a:hover {
    border-color: var(--accent);
    background: var(--accent-wash);
    transform: translateY(-2px);
  }
  .moods b { font-size: 0.98rem; font-weight: 620; color: var(--ink); }
  .moods span { font-size: 0.8rem; color: var(--ink-faint); }

  .domains, .eras {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.55rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
  }
  .domains a, .eras a {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 0.2rem 0.6rem;
    padding: 0.8rem 1rem;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--surface);
    text-decoration: none;
    font-family: var(--font-ui);
    height: 100%;
    border-left: 3px solid var(--dot, var(--line));
    transition: background 0.15s, transform 0.15s;
  }
  .domains a:hover, .eras a:hover { background: var(--surface-alt); transform: translateX(2px); }
  .domains b, .eras b { font-size: 0.95rem; font-weight: 620; color: var(--ink); }
  .domains span, .eras span {
    grid-column: 1;
    font-size: 0.79rem;
    color: var(--ink-faint);
    line-height: 1.4;
  }
  .domains em, .eras em {
    grid-row: 1;
    grid-column: 2;
    font-style: normal;
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
    color: var(--ink-faint);
    background: var(--surface-alt);
    border-radius: 999px;
    padding: 0.1rem 0.45rem;
  }

  .pathcard {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.15rem 1.3rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    text-decoration: none;
    font-family: var(--font-ui);
    box-shadow: var(--shadow);
    transition: box-shadow 0.18s, transform 0.18s;
  }
  .pathcard:hover { box-shadow: var(--shadow-lift); transform: translateY(-2px); }
  .pathcard b { font-size: 1.05rem; color: var(--ink); font-weight: 640; }
  .pathcard > span { font-size: 0.87rem; color: var(--ink-soft); line-height: 1.5; }
  .pathcard ol {
    margin: 0.6rem 0 0;
    padding-left: 1.1rem;
    font-size: 0.83rem;
    color: var(--ink-faint);
  }
  .pathcard li { margin-bottom: 0.15rem; }
  .pathcard__more { list-style: none; margin-left: -1.1rem; font-style: italic; }
</style>
