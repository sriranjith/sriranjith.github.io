---
import Base from '../../layouts/Base.astro';
import { publicCatalog } from '../../lib/catalog.js';
import { url } from '../../lib/site.js';

const catalog = publicCatalog();
const people = catalog.people
  .filter((p) => p.paradoxes.length > 0)
  .sort((a, b) => (a.born ?? 9999) - (b.born ?? 9999));
---

<Base
  title="People"
  description="The philosophers, mathematicians and scientists behind the paradoxes."
>
  <header class="thead">
    <h1>People</h1>
    <p class="lede">
      {people.length} of them, roughly in order of birth. Some posed the problem,
      some solved it, and a few are here because they got it wrong in an
      instructive way.
    </p>
  </header>

  <ul class="ppl">
    {
      people.map((person) => (
        <li>
          <a href={url.person(person.id)}>
            <span class="ppl__dates">
              {person.born ? (person.born < 0 ? `${Math.abs(person.born)} BCE` : person.born) : '—'}
              {person.died ? `–${person.died < 0 ? `${Math.abs(person.died)} BCE` : person.died}` : ''}
            </span>
            <span class="ppl__body">
              <b>{person.name}</b>
              <span class="ppl__bio">{person.bio}</span>
            </span>
            <span class="ppl__count">{person.paradoxes.length}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .thead { padding-block: 2rem 1.5rem; max-width: 42rem; }
  .thead h1 { margin-bottom: 0.4rem; }

  .ppl { list-style: none; padding: 0; margin: 0 0 4rem; border-top: 1px solid var(--line); }
  .ppl li { border-bottom: 1px solid var(--line-soft); }
  .ppl a {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: baseline;
    padding: 0.9rem 0.6rem;
    text-decoration: none;
    border-radius: var(--radius);
  }
  .ppl a:hover { background: var(--surface-alt); }
  .ppl__dates {
    font-family: var(--font-ui);
    font-size: 0.78rem;
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
  }
  .ppl__body { display: flex; flex-direction: column; gap: 0.2rem; min-width: 0; }
  .ppl__body b { font-family: var(--font-ui); font-size: 1rem; font-weight: 600; color: var(--ink); }
  .ppl a:hover .ppl__body b { color: var(--accent-ink); }
  .ppl__bio {
    font-size: 0.88rem;
    color: var(--ink-soft);
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .ppl__count {
    font-family: var(--font-ui);
    font-size: 0.76rem;
    color: var(--ink-faint);
    background: var(--surface-alt);
    border-radius: 999px;
    padding: 0.1rem 0.5rem;
  }
  @media (max-width: 42rem) {
    .ppl a { grid-template-columns: 1fr auto; }
    .ppl__dates { grid-column: 1 / -1; }
  }
</style>
