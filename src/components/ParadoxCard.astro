---
import Figure from './Figure.astro';
import { url } from '../lib/site.js';
import { publicCatalog } from '../lib/catalog.js';

const {
  paradox,
  reason = null,
  compact = false,
  index = null,
  figure = false,
} = Astro.props;

const tx = publicCatalog().taxonomy;
const domain = tx.get('domains', paradox.domains[0]);
const difficulty = tx.get('difficulties', paradox.difficulty);
const entryKind = tx.get('entryKinds', paradox.kind ?? 'paradox');

// The hook states the open question; the summary describes the entry. A card is
// a decision point, so it gets the question. Entries without a hook fall back
// rather than showing nothing.
const blurb = paradox.hook ?? paradox.summary;
const famous = paradox.renown === 'landmark';
const isNonParadox = paradox.kind && paradox.kind !== 'paradox';
---

<article class={`pcard ${compact ? 'pcard--compact' : ''} ${figure ? 'pcard--figured' : ''}`}>
  {index !== null && <span class="pcard__index" aria-hidden="true">{index}</span>}

  {figure && <Figure slug={paradox.slug} variant="card" />}

  <div class="pcard__meta">
    {domain && <span class="tag tag--dot" style={`--dot:${domain.color}`}>{domain.label}</span>}
    {isNonParadox && entryKind && (
      <span class="pcard__kind">{entryKind.label}</span>
    )}
    {famous && <span class="pcard__famous">Famous</span>}
    <span class="pcard__sep" aria-hidden="true">·</span>
    <span class="pcard__difficulty">{difficulty?.label ?? paradox.difficulty}</span>
  </div>

  <h3 class="pcard__title">
    <a href={url.paradox(paradox.slug)}>{paradox.title}</a>
  </h3>

  <p class="pcard__hook">{blurb}</p>

  {reason && <p class="pcard__reason">{reason}</p>}

  <p class="pcard__foot">
    <span>{paradox.date}</span>
    <span aria-hidden="true">·</span>
    <span>{paradox.readingMinutes} min read</span>
  </p>
</article>

<style>
  .pcard {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 1.1rem 1.25rem 1rem;
    box-shadow: var(--shadow);
    transition: box-shadow 0.18s ease, transform 0.18s ease, border-color 0.18s ease;
    height: 100%;
  }
  .pcard:hover {
    box-shadow: var(--shadow-lift);
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--accent) 35%, var(--line));
  }
  /* The figure runs to the card edge, so the index badge would sit on top of it. */
  .pcard--figured { overflow: hidden; }

  .pcard__index {
    position: absolute;
    top: 0.55rem;
    left: 0.75rem;
    z-index: 1;
    font-family: var(--font-ui);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    background: var(--accent);
    color: #fff;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
  }
  .pcard:not(.pcard--figured) .pcard__index { top: -0.55rem; left: 1.1rem; }

  .pcard__meta {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    color: var(--ink-faint);
    margin-bottom: 0.55rem;
    flex-wrap: wrap;
  }
  .pcard__sep { opacity: 0.5; }
  .pcard__difficulty { font-weight: 550; }

  .pcard__kind {
    display: inline-flex;
    align-items: center;
    font-size: 0.68rem;
    font-weight: 620;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent-ink);
    background: var(--accent-wash);
    border-radius: 999px;
    padding: 0.12rem 0.5rem;
  }

  .pcard__famous {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.7rem;
    font-weight: 640;
    letter-spacing: 0.02em;
    color: var(--warm);
    background: var(--warm-wash);
    border-radius: 999px;
    padding: 0.15rem 0.5rem;
  }
  .pcard__famous::before { content: '★'; font-size: 0.65rem; line-height: 1; }

  .pcard__title {
    font-size: 1.13rem;
    margin: 0 0 0.4rem;
    letter-spacing: -0.02em;
  }
  .pcard__title a {
    color: var(--ink);
    text-decoration: none;
  }
  /* The whole card is the hit target, but only the title is the semantic link. */
  .pcard__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .pcard:hover .pcard__title a { color: var(--accent-ink); }

  /* The hook is a question, so it gets the reading face rather than the UI one. */
  .pcard__hook {
    margin: 0;
    font-size: 0.945rem;
    line-height: 1.52;
    color: var(--ink-soft);
    flex: 1;
    text-wrap: pretty;
  }
  .pcard--compact .pcard__hook {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .pcard__reason {
    margin: 0.7rem 0 0;
    font-family: var(--font-ui);
    font-size: 0.775rem;
    color: var(--accent-ink);
    background: var(--accent-wash);
    padding: 0.3rem 0.55rem;
    border-radius: var(--radius);
    align-self: flex-start;
  }

  .pcard__foot {
    display: flex;
    gap: 0.45rem;
    margin: 0.85rem 0 0;
    padding-top: 0.7rem;
    border-top: 1px solid var(--line-soft);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    color: var(--ink-faint);
  }
</style>
