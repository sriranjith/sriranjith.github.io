---
// Reading-depth navigation. Pure anchor links — works with JavaScript disabled.
// A tiny script upgrades it to highlight the section you are currently reading.
// Each depth may carry an `anchor` property that points to the first real layer
// in that depth group (since a depth layer might not always exist).
const { depths } = Astro.props;
---

<nav class="rail" aria-label="Reading depth">
  <p class="rail__title">How deep do you want to go?</p>
  <ol class="rail__list">
    {
      depths.map((depth, i) => {
        const anchor = depth.anchor ?? depth.id;
        return (
          <li>
            <a href={`#${anchor}`} data-rail-link={anchor}>
              <span class="rail__num">{i + 1}</span>
              <span class="rail__body">
                <span class="rail__label">{depth.label}</span>
                <span class="rail__desc">{depth.description}</span>
              </span>
            </a>
          </li>
        );
      })
    }
  </ol>
</nav>

<style>
  .rail {
    font-family: var(--font-ui);
  }
  .rail__title {
    font-size: 0.72rem;
    font-weight: 650;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
    margin: 0 0 0.75rem;
  }
  .rail__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .rail__list a {
    display: flex;
    gap: 0.65rem;
    align-items: flex-start;
    padding: 0.5rem 0.6rem;
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--ink-soft);
    border-left: 2px solid transparent;
  }
  .rail__list a:hover { background: var(--surface-alt); color: var(--ink); }
  .rail__list a[aria-current='true'] {
    background: var(--accent-wash);
    border-left-color: var(--accent);
    color: var(--accent-ink);
  }
  .rail__num {
    flex: none;
    width: 1.35rem;
    height: 1.35rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--surface-alt);
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--ink-faint);
    margin-top: 0.1rem;
  }
  .rail__list a[aria-current='true'] .rail__num { background: var(--accent); color: #fff; }
  .rail__body { display: flex; flex-direction: column; gap: 0.1rem; min-width: 0; }
  .rail__label { font-size: 0.87rem; font-weight: 590; }
  .rail__desc { font-size: 0.745rem; line-height: 1.4; color: var(--ink-faint); }

  @media (max-width: 62rem) {
    .rail {
      /* Bleed the rail edge-to-edge on mobile so the scroll hint is visible */
      margin-inline: calc(-1 * var(--gap, 1rem));
      padding-inline: var(--gap, 1rem);
    }
    .rail__title { display: none; }
    .rail__list {
      flex-direction: row;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      gap: 0.4rem;
      padding-bottom: 0.5rem;
      /* fade-out hint that more items exist */
      -webkit-mask-image: linear-gradient(to right, black 80%, transparent 100%);
      mask-image: linear-gradient(to right, black 80%, transparent 100%);
    }
    .rail__list::-webkit-scrollbar { display: none; }
    .rail__list li { flex: none; }
    .rail__desc { display: none; }
    .rail__list a {
      border-left: 0;
      border: 1px solid var(--line);
      white-space: nowrap;
      padding: 0.4rem 0.8rem;
    }
    .rail__list a[aria-current='true'] { border-color: var(--accent); }
    .rail__num { width: 1.1rem; height: 1.1rem; font-size: 0.62rem; }
  }
</style>

<script>
  // Progressive enhancement only: highlights the depth you have scrolled to.
  const links = document.querySelectorAll('[data-rail-link]');
  const sections = [...links]
    .map((a) => document.getElementById(a.dataset.railLink))
    .filter(Boolean);

  if (sections.length && 'IntersectionObserver' in window) {
    const seen = new Set();
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) seen.add(entry.target.id);
          else seen.delete(entry.target.id);
        }
        const first = sections.find((s) => seen.has(s.id));
        for (const link of links) {
          link.setAttribute('aria-current', String(first && link.dataset.railLink === first.id));
        }
      },
      { rootMargin: '-20% 0px -70% 0px' }
    );
    sections.forEach((s) => observer.observe(s));
  }
</script>
