---
import { renderMarkdown, toPlainText } from '../lib/markdown.js';

// One content layer. Deeper layers ship collapsed inside <details>, which gives
// progressive disclosure with zero JavaScript and full keyboard support.
const { layer, markdown, open } = Astro.props;
const html = renderMarkdown(markdown);

// A closed section that shows only its title asks the reader to open it on
// faith. Showing the opening line instead turns the heading into a reason.
//
// Sections that open on notation are the exception: stripped of its maths,
// "Let $C_i$ be the event…" becomes "Let Ci be the event…", which reads like a
// typo and sells nothing. Those keep the bare heading, which is honest enough.
const raw = open ? '' : toPlainText(markdown, 130);
const preview = (raw.match(/\$/g) ?? []).length > 1 ? null : raw || null;
---

{
  open ? (
    <section class="layer" id={layer.id}>
      <h2 class="layer__heading">{layer.label}</h2>
      <div class="layer__body prose-body" set:html={html} />
    </section>
  ) : (
    <details class="layer layer--collapsible" id={layer.id}>
      <summary class="layer__summary">
        <span class="layer__summary-text">
          <h2 class="layer__heading">{layer.label}</h2>
          {preview && <span class="layer__preview">{preview}</span>}
        </span>
        <span class="layer__chevron" aria-hidden="true" />
      </summary>
      <div class="layer__body prose-body" set:html={html} />
    </details>
  )
}

<style is:global>
  .layer {
    scroll-margin-top: 5rem;
    border-top: 1px solid var(--line);
    padding-top: 1.75rem;
    margin-top: 1.75rem;
  }
  .layer:first-of-type { border-top: 0; padding-top: 0; margin-top: 0; }

  .layer__heading {
    font-size: clamp(1.25rem, 2vw, 1.55rem);
    margin: 0 0 0.75rem;
  }

  .layer--collapsible > .layer__summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-radius: var(--radius);
    margin: -0.4rem -0.6rem 0;
    padding: 0.4rem 0.6rem;
  }
  .layer--collapsible > .layer__summary::-webkit-details-marker { display: none; }
  .layer--collapsible > .layer__summary:hover { background: var(--surface-alt); }
  .layer--collapsible > .layer__summary .layer__heading { margin: 0; }

  .layer__summary-text { display: flex; flex-direction: column; gap: 0.3rem; min-width: 0; }
  .layer__preview {
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--ink-faint);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .layer--collapsible[open] .layer__preview { display: none; }

  .layer__chevron {
    flex: none;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: var(--surface);
    position: relative;
    transition: transform 0.2s ease, background 0.2s;
  }
  .layer__chevron::before,
  .layer__chevron::after {
    content: '';
    position: absolute;
    inset: 50% auto auto 50%;
    background: var(--ink-soft);
    border-radius: 1px;
  }
  .layer__chevron::before { width: 0.7rem; height: 2px; transform: translate(-50%, -50%); }
  .layer__chevron::after { width: 2px; height: 0.7rem; transform: translate(-50%, -50%); transition: opacity 0.2s, transform 0.2s; }
  .layer--collapsible[open] .layer__chevron::after { opacity: 0; transform: translate(-50%, -50%) scaleY(0); }
  .layer--collapsible[open] .layer__chevron { background: var(--accent-wash); border-color: transparent; transform: rotate(0deg); }

  .layer__body { margin-top: 0.9rem; }
  .layer--collapsible[open] .layer__body { margin-top: 1.1rem; }

  /* Fade-in body when a section opens */
  @starting-style {
    .layer--collapsible[open] .layer__body { opacity: 0; translate: 0 -0.3rem; }
  }
  .layer--collapsible[open] .layer__body { transition: opacity 0.25s, translate 0.25s; }

  .prose-body > *:last-child { margin-bottom: 0; }
  .prose-body h3 {
    font-size: 1.08rem;
    margin-top: 1.9rem;
    color: var(--ink);
  }
  .prose-body h4 { font-size: 0.98rem; margin-top: 1.5rem; color: var(--ink-soft); }
  .prose-body table { margin-block: 1.4rem; }
  .prose-body blockquote { margin-block: 1.4rem; }
</style>
